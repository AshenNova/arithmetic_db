<% if (students && students.name[0]) { %>
  <div class="col-md-6">
    <div class="hidden">
      <div id="studentNameId"><%= students.name %></div>
      <div id="studentCountId"><%= students.count %></div>
    </div>
    <h2>Daily Workdone</h2>
    <div style="position: relative; height: 400px;">
      <canvas id="myChart" style="width: 100%;"></canvas>
    </div>
  </div>
<% } %>